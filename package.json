{
	"name": "@cyberace/n8n-nodes-qr",
	"version": "0.1.2",
	"description": "Generate and read PNG QR codes locally in n8n workflows.",
	"license": "MIT",
	"homepage": "https://github.com/EnriqueITE/QR-Toolkit-N8N#readme",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"qr-code",
		"qrcode",
		"automation"
	],
	"author": {
		"name": "Enrique Serrano Aparicio",
		"url": "https://enriqueite.com",
		"email": "hello@enriqueite.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/EnriqueITE/QR-Toolkit-N8N.git"
	},
	"bugs": {
		"url": "https://github.com/EnriqueITE/QR-Toolkit-N8N/issues"
	},
	"engines": {
		"node": ">=22.0.0"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
		"test": "vitest run",
		"test:watch": "vitest",
		"verify": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
		"release": "n8n-node release",
		"prepublishOnly": "npm run verify"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE.md",
		"CHANGELOG.md"
	],
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [],
		"nodes": [
			"dist/nodes/QrToolkit/QrToolkit.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "^0.39.3",
		"@types/node": "24.0.15",
		"@types/pngjs": "^6.0.5",
		"eslint": "9.39.4",
		"jsqr": "^1.4.0",
		"pngjs": "^7.0.0",
		"prettier": "3.8.3",
		"release-it": "^20.2.1",
		"typescript": "5.9.3",
		"vitest": "^3.2.7"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"funding": {
		"type": "buymeacoffee",
		"url": "https://buymeacoffee.com/enriqueite"
	}
}
