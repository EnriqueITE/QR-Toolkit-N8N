{
	"compilerOptions": {
		"strict": true,
		"module": "commonjs",
		"moduleResolution": "node",
		"target": "es2019",
		"lib": ["es2019", "es2020", "es2022.error"],
		"removeComments": true,
		"useUnknownInCatchVariables": true,
		"forceConsistentCasingInFileNames": true,
		"noImplicitAny": true,
		"noImplicitReturns": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"strictNullChecks": true,
		"preserveConstEnums": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"incremental": false,
		"declaration": true,
		"sourceMap": true,
		"skipLibCheck": true,
		"types": ["node"],
		"outDir": "./dist/"
	},
	"include": ["nodes/**/*", "package.json"],
	"exclude": ["dist", "node_modules", "nodes/**/__tests__/**"]
}
